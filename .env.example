# Firebase web configuration. These values identify the Firebase project and
# are safe to expose in the client, but Firebase security rules must still
# protect data and authentication.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend API URL (for local development, use localhost for web/iOS simulator or 10.0.2.2 for Android emulator)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional Cloudinary client config (upload preset / cloud name)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=


# Never put these in an Expo client environment:
# DATABASE_URL=
# CLOUDINARY_URL=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Store server-only values in the backend deployment's secret manager.
