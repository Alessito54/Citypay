{
  "expo": {
    "name": "CityPay",
    "slug": "CityPay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citypay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.citypay.municipal",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.citypay.municipal",
      "adaptiveIcon": {
        "backgroundColor": "#E8F0FD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8F0FD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CityPay accede a tus fotos para adjuntar evidencia a un reporte.",
          "cameraPermission": "CityPay usa la cámara para tomar fotos de evidencia de un reporte."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CityPay usa tu ubicación para indicar dónde ocurre el problema reportado."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "58adc6e8-91da-443d-b7da-43ec99024064"
      }
    },
    "owner": "maurihm"
  }
}
